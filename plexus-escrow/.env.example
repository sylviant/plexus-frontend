# Copy to .env and fill in. Never commit .env.

# Deployer key (only pays gas; it gets no special rights in the contract)
DEPLOYER_PRIVATE_KEY=

BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Safe multisig that owns the contract (2-of-3)
OWNER_MULTISIG=
# Server key that signs quotes and records identity checks
OPERATOR_ADDRESS=
# PLEXUS commission wallet
TREASURY_ADDRESS=

# Testnet only: reuse an existing MockUSDT instead of deploying a new one
TOKEN_ADDRESS=

MIN_REWARD_WITHDRAWAL_USDT=5

# For contract verification on BscScan
ETHERSCAN_API_KEY=
