# Thirdweb dashboard -> Settings -> API Keys -> Client ID
VITE_THIRDWEB_CLIENT_ID=
# Backend API base URL (with /api)
VITE_API_URL=https://site--plexus-backend--pgpb968tdsqh.code.run/api
# Public URL of THIS site (shown in the wallet when connecting). Must match the real domain.
VITE_APP_URL=https://pay.your-domain.com
# Optional: your own Reown (WalletConnect) project id, to get the domain "verified" badge in wallets
VITE_WC_PROJECT_ID=
# Optional: where "Return to PLEXUS" sends the user (comma separated allowed prefixes)
VITE_ALLOWED_RETURN=plexus://,https://plexus-app.vercel.app
